# Public Linux builds hide the Vertex service-account JSON option because its
# current secure storage path depends on the macOS Keychain.
VITE_PUBLIC_DEPLOYMENT=true

# Use the authenticated same-origin /private-asr adapter. If startup fails,
# /learn keeps the existing Octos ASR path as a per-utterance fallback.
VITE_PRIVATE_ASR_ENABLED=true

# Route narration through the optional Octos Learn hosted-TTS sidecar. Local
# development and self-hosted installs should leave this unset unless they
# deliberately deploy that product-specific service.
VITE_HOSTED_TTS_ENABLED=true
