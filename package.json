{
  "name": "octos-learn",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.2",
  "type": "module",
  "scripts": {
    "copy-vad-assets": "node scripts/copy-vad-assets.mjs",
    "setup:https": "node scripts/setup-local-https.mjs",
    "predev": "node scripts/copy-vad-assets.mjs",
    "dev": "vite",
    "dev:https": "vite --mode local-https --host 0.0.0.0",
    "prebuild": "node scripts/copy-vad-assets.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e:smoke": "playwright test tests/learning-smoke.spec.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@google/model-viewer": "^4.3.1",
    "@ricky0123/vad-web": "^0.0.30",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "katex": "^0.16.38",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "octos-lesson-language": "git+https://github.com/alan0x/octos-lesson-language.git#5715f8ab44412d1b14dee3c754b25427ee12e4d9",
    "onnxruntime-web": "^1.26.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.58.2",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^1.6.1"
