# The APK serves bundled assets under the public learn.pitun.cc origin, so it
# must compile the same product services as the public web build. Android-only
# compatibility transforms still come from Vite's `android` mode.
VITE_PUBLIC_DEPLOYMENT=true
VITE_PRIVATE_ASR_ENABLED=true
VITE_HOSTED_TTS_ENABLED=true
VITE_ENABLE_BOARD_WRITING=true
