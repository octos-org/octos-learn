:fragment:moving-point.x","expression":"number_01"},{"target":"trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-plot:fragment:moving-point.y","expression":"cos(number_01)"}]},"placement":{"relation":"right_of","gap":"normal","anchor":"trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-circle"},"region_id":"trig-cosine-and-phase-shift-0.1.4-region"}},{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:1:1:3","op":"board.connect","connection":{"id":"trig-cosine-and-phase-shift-0.1.4:connection:section-01-moment-01-item-01-link","from":{"node_id":"trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-circle"},"to":{"node_id":"trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-plot"},"relation":"maps_to","label":"旋转角与周期波动"}},{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:1:1:4","op":"board.group","group":{"id":"trig-cosine-and-phase-shift-0.1.4:group:section-01-moment-01-item-01","title":"单位圆与函数图像","role":"main_visual","members":["trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-circle","trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-plot"]}}],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:1:1:5","op":"board.focus","focus":{"targets":["trig-cosine-and-phase-shift-0.1.4:group:section-01-moment-01-item-01"],"intent":"观察动点 P 在 x 轴上的横坐标投影"}}],"after_speech":[]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-01:beat:moment-02","narration":{"text":"注意看，随着角度 θ 的改变，x 轴上的投影红线长度也在实时跟着变化。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:1:2:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":1.57,"easing":"linear","duration_intent":"normal"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"trig-cosine-and-phase-shift-0.1.4","sequence":2,"step":{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-02","purpose":"从单位圆旋转推导余弦曲线 y = cos θ 的关键点变化与展开过程","beats":[{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-02:beat:moment-01","narration":{"text":"在单位圆中，动点 P 的横坐标代表余弦值 cos θ。当我们旋转动点，注意看它在 x 轴上的投影长度变化。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:2:1:1","op":"board.focus","focus":{"targets":["trig-cosine-and-phase-shift-0.1.4:group:section-01-moment-01-item-01"],"intent":"观察动点P在x轴上的投影与余弦值的对应关系"}},{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:2:1:2","op":"teacher.point","target":{"group_id":"trig-cosine-and-phase-shift-0.1.4:group:section-01-moment-01-item-01"}}],"after_speech":[]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-02:beat:moment-02","narration":{"text":"当 θ = 0 时，投影在最右侧，横坐标达到最大值 1。","delivery":"neutral"},"stage":{"before_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:2:2:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":0,"easing":"linear","duration_intent":"brief"}}],"during_speech":[],"after_speech":[]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-02:beat:moment-03","narration":{"text":"随着逆时针旋转，在 θ = π/2 时，投影回到原点，横坐标降为 0。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:2:3:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":1.57,"easing":"linear","duration_intent":"normal"}}],"after_speech":[]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-02:beat:moment-04","narration":{"text":"继续旋转至 θ = π 时，投影到达最左侧，横坐标达到最低值 -1。将这一过程在平面直角坐标系中展开，就得到了余弦曲线 y = cos θ。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:2:4:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":3.14,"easing":"linear","duration_intent":"extended"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"trig-cosine-and-phase-shift-0.1.4","sequence":3,"step":{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-03","purpose":"对比正余弦波形，推导平移关系与诱导公式 cos θ = sin(θ + π/2)","beats":[{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-03:beat:moment-01","narration":{"text":"大家请看单位圆，动点 P 在圆周上运动，其在 x 轴上的投影坐标正好对应着 cos θ 的数值。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:1:1","op":"board.focus","focus":{"targets":["trig-cosine-and-phase-shift-0.1.4:group:section-01-moment-01-item-01"],"intent":"引导观察动点P在x轴上的投影位置"}}],"after_speech":[]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-03:beat:moment-02","narration":{"text":"现在我们将余弦曲线 y 等于 cos x 与正弦曲线 y 等于 sin x 绘制在同一个坐标系中进行对比。","delivery":"neutral"},"stage":{"before_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:2:1","op":"board.create","node":{"id":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-01","kind":"plot","role":"comparison_visual","content":{"title":"正弦与余弦曲线对比","axes":{"x":{"min":-6.283185307179586,"max":6.283185307179586,"label":"x"},"y":{"min":-1.5,"max":1.5,"label":"y"}},"curves":[{"id":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-01:fragment:primary-curve","expression":"cos(x)","label":"y = cos x"},{"id":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-01:fragment:curve-02","expression":"sin(x)","label":"y = sin x"}]},"placement":{"relation":"right_of","anchor":"trig-cosine-and-phase-shift-0.1.4:group:section-01-moment-01-item-01"},"region_id":"trig-cosine-and-phase-shift-0.1.4-region"}}],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:2:2","op":"board.create","node":{"id":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-02","kind":"math","role":"derivation","content":{"latex":"y = \\cos x, \\quad y = \\sin x"},"placement":{"relation":"below","anchor":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-01"},"region_id":"trig-cosine-and-phase-shift-0.1.4-region"}},{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:2:3","op":"board.focus","focus":{"targets":["trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-plot","trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-01"],"intent":"把余弦曲线与新画出的正弦余弦对比图放在一起观察"}}],"after_speech":[]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-03:beat:moment-03","narration":{"text":"对比两条曲线可以发现，它们的波形形状完全相同。余弦曲线的波峰在 x 等于 0 时出现，比正弦曲线提前了二分之派个单位。几何上，这相当于将正弦图像整体向左平移了二分之派个单位。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:3:1","op":"teacher.point","target":{"node_id":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-01"}},{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:3:2","op":"lesson.variable.animate","animation":{"variable":"number_01","to":0,"easing":"linear","duration_intent":"extended"}}],"after_speech":[]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-03:beat:moment-04","narration":{"text":"由此可知，余弦函数与正弦函数满足关系式 cos θ 等于 sin(θ 加二分之派)。这就是著名的诱导公式。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[],"after_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:4:1","op":"board.create","node":{"id":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-04-item-01","kind":"math","role":"derivation","content":{"latex":"\\cos\\theta = \\sin\\left(\\theta + \\frac{\\pi}{2}\\right)"},"placement":{"relation":"below","anchor":"trig-cosine-and-phase-shift-0.1.4:node:section-03-moment-02-item-02"},"region_id":"trig-cosine-and-phase-shift-0.1.4-region"}}]}},{"id":"trig-cosine-and-phase-shift-0.1.4:step:section-03:beat:moment-05","narration":{"text":"现在我把旋转角度 θ 从 0 一直转到 2π。注意观察余弦值的变化：θ 等于 0 时是波峰 1，经过零点二分之派，到 π 时降到波谷负一，再经过零点二分之三派，回到 2π 时又是波峰。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:5:1","op":"board.focus","focus":{"targets":["trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-circle","trig-cosine-and-phase-shift-0.1.4:node:section-01-moment-01-item-01-plot"],"intent":"观察 θ 转过一整周时余弦值的波峰、零点与波谷"}},{"action_id":"trig-cosine-and-phase-shift-0.1.4:action:3:5:2","op":"lesson.variable.animate","animation":{"variable":"number_01","to":6.28,"easing":"linear","duration_intent":"extended"}}],"after_speech":[]}}]}}
