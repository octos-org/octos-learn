{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "圆与正多边形的周长夹逼",
    "goals": [
      "比较内接、外切正多边形的周长与圆周长"
    ],
    "variables": [
      {
        "as": "number_01",
        "initial": 6,
        "min": 6,
        "max": 96,
        "label": "多边形边数",
        "unit": "边",
        "control": {
          "kind": "slider",
          "step": 1
        }
      }
    ],
    "tasks": [
      {
        "as": "section-01-task-01",
        "prompt": "把多边形边数调到96边。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "拖动滑块。"
        ],
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 96,
          "tolerance": 0.5
        }
      }
    ]
  },
  "steps": [
    {
      "key": "section-01",
      "purpose": "观察边数增加时的周长夹逼",
      "beats": [
        {
          "key": "moment-01",
          "say": "增加边数，观察内接与外切正多边形逐渐逼近固定的圆。",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-01-item-01",
              "kind": "geometry",
              "role": "main_visual",
              "content": {
                "title": "阿基米德割圆逼近法",
                "axes": {
                  "x": {
                    "min": -2.7250932705750333,
                    "max": 2.7250932705750333,
                    "label": "x"
                  },
                  "y": {
                    "min": -2.7250932705750333,
                    "max": 2.7250932705750333,
                    "label": "y"
                  },
                  "equal_scale": true
                },
                "points": [
                  {
                    "as": "center",
                    "x": 0,
                    "y": 0,
                    "label": "O"
                  }
                ],
                "circles": [
                  {
                    "as": "circle",
                    "center": "center",
                    "radius": 2,
                    "label": "r = 2"
                  }
                ],
                "regular_polygons": [
                  {
                    "as": "inscribed",
                    "center": "center",
                    "radius": 2,
                    "sides": 6,
                    "relation": "inscribed",
                    "tone": "primary",
                    "label": "内接正多边形",
                    "show_measurements": true
                  },
                  {
                    "as": "circumscribed",
                    "center": "center",
                    "radius": 2,
                    "sides": 6,
                    "relation": "circumscribed",
                    "tone": "accent",
                    "label": "外切正多边形",
                    "show_measurements": true
                  }
                ],
                "caption": "绿色内接周长 < 圆周长 < 橙色外切周长。除以直径 2r：n sin(π/n) < π < n tan(π/n)。显示值为近似值；边数增加时上下界共同逼近 π。",
                "bindings": [
                  {
                    "target": "inscribed.sides",
                    "expression": "round(number_01)"
                  },
                  {
                    "target": "circumscribed.sides",
                    "expression": "round(number_01)"
                  }
                ]
              },
              "place": {
                "relation": "new_region",
                "region_role": "section-01"
              }
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "内接周长 / 直径 < π < 外切周长 / 直径。",
    "focus": [
      "section-01-moment-01-item-01"
    ]
  }
}
