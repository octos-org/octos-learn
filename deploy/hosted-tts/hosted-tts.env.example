# Root-owned (0600). This file is only for the hosted Octos Learn service.
HOST=127.0.0.1
PORT=50081
OCTOS_BASE_URL=http://127.0.0.1:50080
DATABASE_PATH=/var/lib/octos-learn/hosted-tts/usage.sqlite

VOLC_TTS_APPID=replace-with-platform-app-id
VOLC_TTS_TOKEN=replace-with-platform-token
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=BV001_streaming
VOLC_TTS_ENCODING=mp3

HOSTED_TTS_MAX_CONCURRENT=2
HOSTED_TTS_QUEUE_WAIT_MS=3000
HOSTED_TTS_REQUESTS_PER_MINUTE=60
