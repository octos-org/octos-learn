# Root-owned (0600). This file is only for the hosted Octos Learn service.
HOST=127.0.0.1
PORT=50081
OCTOS_BASE_URL=http://127.0.0.1:50080
DATABASE_PATH=/var/lib/octos-learn/hosted-tts/usage.sqlite
HOSTED_TTS_CACHE_DIRECTORY=/var/lib/octos-learn/hosted-tts/audio-cache
HOSTED_TTS_CACHE_MAX_BYTES=2147483648
HOSTED_TTS_CACHE_MAX_ENTRIES=10000

VOLC_TTS_APPID=replace-with-platform-app-id
VOLC_TTS_TOKEN=replace-with-platform-token
VOLC_TTS_CLUSTER=volcano_tts
VOLC_TTS_VOICE=BV001_streaming
VOLC_TTS_ENCODING=mp3

# Temporary public deployment policy (2026-10-04): preserve Android direct TTS
# to avoid routing domestic TTS audio through the Singapore backend.
# Explicit opt-in: authenticated clients receive the shared platform credential
# and can call the provider outside hosted quota enforcement. Unset/0 keeps it
# server-side; the application's default remains disabled.
OCTOS_LEARN_TTS_PLATFORM_TOKEN_DISTRIBUTE=1

# TypeSafe Jev Admission Fast-Gate API key
TYPESAFE_API_KEY=replace-with-typesafe-api-key

HOSTED_TTS_MAX_CONCURRENT=2
HOSTED_TTS_QUEUE_WAIT_MS=3000
HOSTED_TTS_REQUESTS_PER_MINUTE=60

# Enable cloud ASR fallback after granting volc.bigasr.auc_turbo access.
# ASR app/token default to VOLC_TTS_APPID/TOKEN when omitted; an Ark LLM key
# is not a substitute for the speech service credential.
HOSTED_ASR_ENABLED=0
# VOLC_ASR_APPID=replace-with-asr-app-id
# VOLC_ASR_TOKEN=replace-with-asr-token
# VOLC_ASR_API_KEY=replace-with-new-console-speech-key
HOSTED_ASR_DAILY_SECONDS=3600
HOSTED_ASR_USER_DAILY_SECONDS=600
