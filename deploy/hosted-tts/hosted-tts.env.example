# BYOK replacement for the existing hosted-tts unit, mode 0600.
# Install as /etc/octos-learn/byok.env (do not reuse the old platform secrets file).
# The unit now runs services/byok/start.mjs. No supplier credentials here.
HOST=127.0.0.1
PORT=50081
OCTOS_BASE_URL=http://127.0.0.1:50080
OCTOS_REGISTRY_ROOT=/var/lib/octos-learn/octos
OCTOS_LEARN_HISTORY_DB=/var/lib/octos-learn/learning/history.sqlite
