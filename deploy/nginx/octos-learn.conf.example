map $http_upgrade $octos_connection_upgrade {
    default upgrade;
    '' close;
}

# The ASR control plane validates browser WebSocket origins against its own
# public origin. Translate only this application's trusted origin; all other
# origins remain unchanged and are still rejected by the upstream allowlist.
map $http_origin $octos_private_asr_origin {
    default $http_origin;
    "https://learn.example.com" "https://asr.example.com";
}

limit_req_zone $binary_remote_addr zone=octos_otp_send:10m rate=3r/m;

server {
    listen 80;
    listen [::]:80;
    server_name learn.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name learn.example.com;

    ssl_certificate /etc/letsencrypt/live/learn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn.example.com/privkey.pem;

    root /opt/octos-learn/web;
    index index.html;
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(self), microphone=(self)" always;

    # OTP sending receives an additional per-IP limit at the public edge.
    # Octos retains its own per-email and failed-verification limits.
    location = /api/auth/send-code {
        limit_req zone=octos_otp_send burst=2 nodelay;
        proxy_pass http://127.0.0.1:50080;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Full-BYOK cutover: apply only after the product adapter, Web and APK
    # pass the migration checks in docs/FULL_BYOK_IMPLEMENTATION_PLAN.md.
    # Old APKs receive no supplier credential and can clear their legacy copy.
    location = /api/learn/tts/native-config {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"version":1,"enabled":false}';
    }
    location ^~ /api/learn/tts/ { return 410; }
    location ^~ /api/learn/asr/ { return 410; }
    location ^~ /api/systemone/ { return 410; }
    location ^~ /api/voice/ { return 410; }
    location ^~ /api/private-asr/ { return 410; }

    # Withdrawn Octos extension: never expose the old raw-key sync route.
    location ^~ /api/my/client-services { return 410; }

    # Product-owned metadata / save / relay; no saved-key export.
    location ^~ /api/learn/byok {
        proxy_pass http://127.0.0.1:50081;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        client_max_body_size 8m;
        proxy_read_timeout 40s;
    }

    # Public reviewed CoursePacks are immutable static releases, not learner
    # sessions. These longer ^~ locations override the generic /api/ proxy
    # and the static-asset extension regex. Keep the source catalog and
    # publisher audit log outside the public releases/ alias.
    location = /api/learn/course-packs {
        alias /opt/octos-learn/course-packs/catalog.json;
        default_type application/json;
        disable_symlinks on;
        etag on;
        add_header Cache-Control "public, max-age=60, must-revalidate";
    }

    location ^~ /api/learn/course-packs/ {
        alias /opt/octos-learn/course-packs/releases/;
        autoindex off;
        disable_symlinks on;
        etag on;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # File handles end in .jpg/.png/etc. Keep all API requests on the
    # authenticated backend, ahead of the static-asset regex locations.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:50080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $octos_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass http://127.0.0.1:50080/health;
        access_log off;
    }

    location ^~ /private-asr/ { return 410; }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # onnxruntime-web loads its ESM glue with dynamic import(). Browsers reject
    # the module when older Nginx mime.types files serve .mjs as octet-stream.
    location ~* \.mjs$ {
        default_type application/javascript;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|wasm|onnx|png|jpg|jpeg|gif|svg|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }
}
