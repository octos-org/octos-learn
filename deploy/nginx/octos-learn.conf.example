map $http_upgrade $octos_connection_upgrade {
    default upgrade;
    '' close;
}

# The ASR control plane validates browser WebSocket origins against its own
# public origin. Translate only this application's trusted origin; all other
# origins remain unchanged and are still rejected by the upstream allowlist.
map $http_origin $octos_private_asr_origin {
    default $http_origin;
    "https://learn.example.com" "https://asr.example.com";
}

limit_req_zone $binary_remote_addr zone=octos_otp_send:10m rate=3r/m;

server {
    listen 80;
    listen [::]:80;
    server_name learn.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name learn.example.com;

    ssl_certificate /etc/letsencrypt/live/learn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn.example.com/privkey.pem;

    root /opt/octos-learn/web;
    index index.html;
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(self), microphone=(self)" always;

    # OTP sending receives an additional per-IP limit at the public edge.
    # Octos retains its own per-email and failed-verification limits.
    location = /api/auth/send-code {
        limit_req zone=octos_otp_send burst=2 nodelay;
        proxy_pass http://127.0.0.1:50080;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # File handles end in .jpg/.png/etc. Keep all API requests on the
    # authenticated backend, ahead of the static-asset regex locations.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:50080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $octos_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass http://127.0.0.1:50080/health;
        access_log off;
    }

    # The trailing slash deliberately strips /private-asr/ before forwarding.
    # The control plane accepts one-time Octos-issued browser grants. Never put
    # its long-lived Octos service token or operator token in this public proxy.
    location ^~ /private-asr/ {
        proxy_pass https://asr.example.com/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $octos_connection_upgrade;
        proxy_set_header Host asr.example.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $octos_private_asr_origin;
        # Keep the HttpOnly session cookie isolated under this proxy prefix,
        # while making it available to both session HTTP calls and the event
        # WebSocket. Some upstream frameworks retain only one of two cookies
        # when both have the same name but different paths.
        proxy_cookie_path ~^/(?:api/v1/sessions|ws/client)/.*$ /private-asr/;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # onnxruntime-web loads its ESM glue with dynamic import(). Browsers reject
    # the module when older Nginx mime.types files serve .mjs as octet-stream.
    location ~* \.mjs$ {
        default_type application/javascript;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|wasm|onnx|png|jpg|jpeg|gif|svg|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }
}
