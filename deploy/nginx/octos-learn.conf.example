map $http_upgrade $octos_connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=octos_otp_send:10m rate=3r/m;

server {
    listen 80;
    listen [::]:80;
    server_name learn.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name learn.example.com;

    ssl_certificate /etc/letsencrypt/live/learn.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learn.example.com/privkey.pem;

    root /opt/octos-learn/web;
    index index.html;
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(self), microphone=(self)" always;

    # OTP sending receives an additional per-IP limit at the public edge.
    # Octos retains its own per-email and failed-verification limits.
    location = /api/auth/send-code {
        limit_req zone=octos_otp_send burst=2 nodelay;
        proxy_pass http://127.0.0.1:50080;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:50080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $octos_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location = /health {
        proxy_pass http://127.0.0.1:50080/health;
        access_log off;
    }

    # The trailing slash deliberately strips /private-asr/ before forwarding.
    # The control plane accepts one-time Octos-issued browser grants. Never put
    # its long-lived Octos service token or operator token in this public proxy.
    location /private-asr/ {
        proxy_pass https://asr.example.com/;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $octos_connection_upgrade;
        proxy_set_header Host asr.example.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The upstream protects session control and event WebSockets with two
        # path-scoped HttpOnly cookies. Rewrite their paths to the same-origin
        # proxy prefix or the browser will not send them back.
        proxy_cookie_path ~^/api/v1/sessions/(.*)$ /private-asr/api/v1/sessions/$1;
        proxy_cookie_path ~^/ws/client/(.*)$ /private-asr/ws/client/$1;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # onnxruntime-web loads its ESM glue with dynamic import(). Browsers reject
    # the module when older Nginx mime.types files serve .mjs as octet-stream.
    location ~* \.mjs$ {
        default_type application/javascript;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|css|wasm|onnx|png|jpg|jpeg|gif|svg|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }
}
