# Copy to /etc/octos-learn/octos-learn.env, make it root-owned and mode 0600.
# Do not commit the real file.
SMTP_PASSWORD=replace-with-smtp-app-password
RUST_LOG=info

# Product-owned capabilities available to every Learn account. Keep this
# directory root-owned and deploy learning-coach here; users do not install it.
OCTOS_SKILLS_PATH=/opt/octos-learn/skills

# Platform-funded Learn narration is not configured in Octos. Hosted releases
# run the product-specific sidecar documented in deploy/hosted-tts instead.

# Keep the public browser origin exact. This overrides appui.allowed_origins.
OCTOS_APPUI_ALLOWED_ORIGINS=https://learn.example.com

# 课程模型由每个用户在设置中选择；不要在本文件中设置 OLL_PROVIDER / OLL_MODEL，也不要放任何模型 API key

# Private-ASR server-to-server exchange. The URL must be HTTPS except for a
# loopback development service. Never expose this token to the browser.
PRIVATE_ASR_CONTROL_URL=https://asr.example.com
PRIVATE_ASR_SERVICE_TOKEN=replace-with-at-least-24-random-characters
