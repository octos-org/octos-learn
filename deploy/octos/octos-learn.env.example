# Copy to /etc/octos-learn/octos-learn.env, make it root-owned and mode 0600.
# Do not commit the real file.
SMTP_PASSWORD=replace-with-smtp-app-password
RUST_LOG=info

# Keep the public browser origin exact. This overrides appui.allowed_origins.
OCTOS_APPUI_ALLOWED_ORIGINS=https://learn.example.com

# Optional platform-owned fallback model. User BYOK settings remain profile-scoped.
# GEMINI_API_KEY=replace-only-if-the-service-owns-a-fallback-key

# Added in the private-ASR integration phase. Never expose this value to the browser.
# PRIVATE_ASR_SERVICE_TOKEN=replace-after-asr-service-auth-is-implemented
