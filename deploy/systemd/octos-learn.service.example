[Unit]
Description=Octos Learn API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=octos-learn
Group=octos-learn
WorkingDirectory=/var/lib/octos-learn/workspace
EnvironmentFile=/etc/octos-learn/octos-learn.env
ExecStart=/opt/octos-learn/bin/octos serve --host 127.0.0.1 --port 50080 --data-dir /var/lib/octos-learn/octos --config /etc/octos-learn/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/octos-learn
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
