[Unit]
Description=Octos Learn BYOK adapter (replaces hosted TTS)
After=network-online.target octos-learn.service
Wants=network-online.target

[Service]
Type=simple
User=octos-learn
Group=octos-learn
WorkingDirectory=/opt/octos-learn/services/byok
EnvironmentFile=/etc/octos-learn/hosted-tts.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/usr/bin/env node start.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/octos-learn/octos
UMask=0077

[Install]
WantedBy=multi-user.target
