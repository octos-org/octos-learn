# Vite development proxy target for the Octos server.
OCTOS_API_TARGET=http://127.0.0.1:50080
OCTOS_VOICE_SERVICE_TARGET=http://127.0.0.1:50081
PRIVATE_ASR_PROXY_TARGET=https://asr.pitun.cc

# Same priority in all modes: private voice service -> cloud fallback.
VITE_CLOUD_ASR_ENABLED=true
VITE_PRIVATE_ASR_ENABLED=true

# CoursePack requests default to https://learn.pitun.cc in local development.
# Set this only to test locally built, unpublished course packs:
# OCTOS_LOCAL_COURSE_PACK_ROOT=/absolute/path/to/publication
