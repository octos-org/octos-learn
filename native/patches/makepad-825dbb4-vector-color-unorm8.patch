     }
 
+    /// True when an untyped `Vec<f32>` vertex buffer is a valid image of
+    /// this layout: every input is an f32 lane, or a `U8x4Norm` color that
+    /// the producer bit-packs into one f32 slot (`pack_unorm8x4`). Fetching
+    /// such colors as bytes rather than as a float keeps opaque colors whose
+    /// bit pattern is a NaN exact (GLES drivers quiet NaN float attributes).
+    pub fn f32_buffer_compatible(&self) -> bool {
+        self.stride_bytes % 4 == 0
+            && self.inputs.iter().all(|i| {
+                i.byte_offset % 4 == 0
+                    && (i.attr_format.is_f32_lane() || matches!(i.attr_format, DrawShaderAttrFormat::U8x4Norm))
+            })
+    }
+
     pub fn all_f32_lanes(&self) -> bool {
         !self.inputs.is_empty() && self.inputs.iter().all(|i| i.attr_format.is_f32_lane())
     }
