diff --git a/draw/src/geometry/typed_vertex_test.rs b/draw/src/geometry/typed_vertex_test.rs
index da170ce28..3b0cb48c5 100644
--- a/draw/src/geometry/typed_vertex_test.rs
+++ b/draw/src/geometry/typed_vertex_test.rs
@@ -216,7 +216,9 @@ fn legacy_vector_vertex_packed_layout_stays_twelve_f32_lanes() {
         live_id!(param5),
         live_id!(zbias),
     ] {
-        inputs.push(id, 1, DrawShaderAttrFormat::F32x1);
+        // color is fetched as normalized bytes, never as an f32 bitcast.
+        let format = if id == live_id!(color) { DrawShaderAttrFormat::U8x4Norm } else { DrawShaderAttrFormat::F32x1 };
+        inputs.push(id, format.logical_slots(), format);
     }
     inputs.finalize();
     assert_eq!(size_of::<VectorVertexPacked>(), 48);
@@ -237,13 +239,27 @@ fn legacy_vector_vertex_packed_layout_stays_twelve_f32_lanes() {
         ],
         [0, 4, 8, 12, 16, 20, 24, 28, 32, 36, 40, 44]
     );
-    assert_eq!(inputs.total_slots, 12);
     assert_eq!(inputs.stride_bytes, 48);
     assert_eq!(
         inputs.inputs.iter().map(|input| input.byte_offset).collect::<Vec<_>>(),
         (0..12).map(|index| index * 4).collect::<Vec<_>>()
     );
-    assert!(inputs.all_f32_lanes());
+    assert!(!inputs.all_f32_lanes());
+}
+
+/// Opaque colors with blue >= 0x80 pack to NaN bit patterns (alpha is the
+/// top byte, blue's bit 7 is the exponent's low bit). They must survive as
+/// bytes; the vertex layout above fetches them as U8x4Norm so no float
+/// conversion (and no NaN quieting, which set blue bit 6) happens.
+#[test]
+fn packed_vector_color_bytes_are_exact() {
+    use crate::vector::pack_unorm8x4;
+    for (rgb, a) in [(0x168398u32, 1.0f32), (0x7a5aa3, 1.0), (0x7a5aa3, 0.13), (0xffffff, 1.0), (0x000080, 0.5)] {
+        let c = |shift: u32| ((rgb >> shift) & 0xff) as f32 / 255.0;
+        let bits = pack_unorm8x4(c(16), c(8), c(0), a).to_bits();
+        assert_eq!(bits & 0xff_ffff, ((rgb & 0xff) << 16) | (rgb & 0xff00) | ((rgb >> 16) & 0xff));
+        assert_eq!(bits >> 24, (a * 255.0 + 0.5) as u32);
+    }
 }
 
